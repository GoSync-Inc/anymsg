{
  "name": "deedkit",
  "version": "0.9.19",
  "description": "GoSync DeedKit JavaScript client and CLI for agents using a self-hosted DeedKit gateway",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
