      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "bin": {
    "anymsg": "bin/anymsg.js"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "author": "GoSync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoSync-Inc/anymsg.git",
    "directory": "packages/npm"
  },
  "homepage": "https://github.com/GoSync-Inc/anymsg#readme",
  "bugs": {
    "url": "https://github.com/GoSync-Inc/anymsg/issues"
  },
  "keywords": [
    "mcp",
    "messenger",
    "telegram",
    "whatsapp",
    "agents",
    "archive"
  ],
