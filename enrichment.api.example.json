{
  "enabled": false,
  "accounts": ["replace-with-account-id"],
  "max_jobs_per_day": 20,
  "profiles": {
    "audio": {
      "provider": "openai",
      "model": "replace-with-transcription-model",
      "allow_cloud": true,
      "api_key_file": "/run/secrets/enrichment-keys/openai",
      "max_audio_seconds": 1800,
      "max_input_bytes": 20971520
    },
    "image": {
      "provider": "anthropic",
      "model": "replace-with-vision-model",
      "allow_cloud": true,
      "api_key_file": "/run/secrets/enrichment-keys/anthropic"
    },
    "document": {
      "provider": "gemini",
      "model": "replace-with-text-model",
      "allow_cloud": true,
      "api_key_file": "/run/secrets/enrichment-keys/gemini"
    }
  }
}
